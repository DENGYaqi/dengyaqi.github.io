{
  "name": "yaqi-projects",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "vars": {
    "LAUNCH_ENABLED": "false",
    "LOCAL_LAUNCH_ENABLED": "true",
    "LOCAL_LAUNCH_ISSUER": "https://yaqi-projects.yaqidengtravail.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yaqi-projects",
      "database_id": "c780cc52-0c12-4b0d-aee9-349107881f1b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "yaqi-projects-media"
    }
  ]
}
